# Server
PORT=3001
NODE_ENV=development

# Authentication (change in production)
AUTH_SECRET=change-this-secret-in-production
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin@123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
USER_USERNAME=user
USER_PASSWORD=User@123

# OpenAI — required for AI chat
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Google OAuth — for Sign in with Google + Drive sync + OTP to Gmail
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3001/api/sources/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/sources/google/callback

# Microsoft OneDrive / SharePoint (optional — for cloud sync without local OneDrive folder)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# ONEDRIVE_USER_EMAIL=user@yourcompany.com

# Dropbox
# DROPBOX_ACCESS_TOKEN=

# Box
# BOX_ACCESS_TOKEN=
# BOX_FOLDER_ID=

# Frontend URL for CORS (production)
FRONTEND_URL=http://localhost:5500

# SMTP — required for login and source-connect OTP emails
# Gmail example: enable 2FA, create an App Password, use smtp.gmail.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="SmorX.ai DMS <your@gmail.com>"

# Dev fallback when SMTP_* is not set — OTP preview URL prints in server console
# OTP_USE_ETHEREAL=true
