!macro customInstall
  DetailPrint "Installing SmorX.ai DMS locally on this computer..."
  DetailPrint "Copying application files..."
  Sleep 400
  DetailPrint "Writing Start Menu and Desktop shortcuts..."
  Sleep 400
  DetailPrint "Finishing local setup..."
!macroend

!macro customUnInstall
  DetailPrint "Removing SmorX.ai DMS from this computer..."
!macroend
